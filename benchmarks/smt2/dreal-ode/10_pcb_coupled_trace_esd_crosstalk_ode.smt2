(declare-fun Cm_xtalk () Real)
(assert (and (>= Cm_xtalk 0.0) (<= Cm_xtalk (/ 1.0 1000000000.0))))
; Mutual trace inductance L_m [H] (xtalk)
(declare-fun Lm_xtalk () Real)
(assert (and (>= Lm_xtalk 0.0) (<= Lm_xtalk (/ 1.0 1000000.0))))
