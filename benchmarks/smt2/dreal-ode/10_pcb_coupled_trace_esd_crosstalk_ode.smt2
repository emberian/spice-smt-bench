(assert (= (* seeff_xtalk_p seeff_xtalk_p) eeff_xtalk_p))
; Pure-exp logarithm constraint exp(lnz_xtalk_p) = arg (Wheeler-Hammerstad log geometry factor (xtalk_p))
(assert (= (exp lnz_xtalk_p) 4.650511470282))
; Characteristic impedance Z0 * sqrt(e_eff) = 60 * ln(8/u + u/4) (xtalk_p)
(assert (= (* Z0_xtalk_p seeff_xtalk_p) (* 60.0 lnz_xtalk_p)))
; Microstrip total inductance L_tot (xtalk_p)
(assert (= Ltot_xtalk_p (/ (* 0.045 (* Z0_xtalk_p seeff_xtalk_p)) 299792458.0)))
; Microstrip total capacitance C_tot (xtalk_p)
(assert (= (* Ctot_xtalk_p Z0_xtalk_p) (/ (* 0.045 seeff_xtalk_p) 299792458.0)))
; Trapezoidal-etched copper DC resistance R_dc (xtalk_p)
(assert (= (* Rdc_xtalk_p 0.35525) 0.045))
; Algebraic sqrt constraint su_xtalk_n^2 = radicand (Hammerstad-Jensen sqrt(1 + 12/u) for xtalk_n)
(assert (= (* su_xtalk_n su_xtalk_n) 7.256517205422))
; Hammerstad-Jensen effective permittivity (xtalk_n)
(assert (= eeff_xtalk_n (+ (/ (+ er_vic 1.0) 2.0) (/ (- er_vic 1.0) (* 2.0 su_xtalk_n)))))
; Algebraic sqrt constraint seeff_xtalk_n^2 = radicand (sqrt(e_eff) for xtalk_n)
(assert (= (* seeff_xtalk_n seeff_xtalk_n) eeff_xtalk_n))
; Pure-exp logarithm constraint exp(lnz_xtalk_n) = arg (Wheeler-Hammerstad log geometry factor (xtalk_n))
(assert (= (exp lnz_xtalk_n) 4.650511470282))
; Characteristic impedance Z0 * sqrt(e_eff) = 60 * ln(8/u + u/4) (xtalk_n)
(assert (= (* Z0_xtalk_n seeff_xtalk_n) (* 60.0 lnz_xtalk_n)))
; Microstrip total inductance L_tot (xtalk_n)
(assert (= Ltot_xtalk_n (/ (* 0.045 (* Z0_xtalk_n seeff_xtalk_n)) 299792458.0)))
; Microstrip total capacitance C_tot (xtalk_n)
(assert (= (* Ctot_xtalk_n Z0_xtalk_n) (/ (* 0.045 seeff_xtalk_n) 299792458.0)))
; Trapezoidal-etched copper DC resistance R_dc (xtalk_n)
(assert (= (* Rdc_xtalk_n 0.35525) 0.045))
; Exponential edge-coupling law kc = exp(-1.9 * s_eff / h_eff) (xtalk)
(assert (= kc_xtalk (exp (- (/ (* 1.9 (+ (/ 2.0 10000.0) ds_etch)) (/ 1.0 10000.0))))))
