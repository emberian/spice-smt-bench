(assert (= (* M_xtalk_n_xtalk_p M_xtalk_n_xtalk_p) (* (* kc_xtalk kc_xtalk) (* (+ Ltot_xtalk_p l_via) (+ Ltot_xtalk_n l_via)))))

; --- Continuous ODE Flow Variables & Initial/Final Endpoints ---
