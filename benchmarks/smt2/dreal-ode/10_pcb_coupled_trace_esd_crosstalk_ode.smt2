(define-ode flow_1 (
  (= d/dt[t] 1.0)
  (= d/dt[v_agg_in] (/ (+ (* (+ (* 0.5 Ctot_xtalk_n) (* 0.5 Cm_xtalk)) (- (/ (- (/ 1.8 (+ 1.0 (exp (- (/ (- t (/ 1.0 10000000000.0)) (/ 5.0 100000000000.0)))))) v_agg_in) 28.0) i_xtalk_p)) (* (* 0.5 Cm_xtalk) (- (- (/ v_vic_in 50.0)) i_xtalk_n))) (+ (* (* 0.5 Ctot_xtalk_p) (* 0.5 Ctot_xtalk_n)) (* (* 0.5 Cm_xtalk) (+ (* 0.5 Ctot_xtalk_p) (* 0.5 Ctot_xtalk_n))))))
  (= d/dt[v_agg_out] (/ (+ (* (+ (+ (* 0.5 Ctot_xtalk_n) (/ 2.5 1000000000000.0)) (* 0.5 Cm_xtalk)) (- i_xtalk_p (/ v_agg_out 50.0))) (* (* 0.5 Cm_xtalk) (+ (- i_xtalk_n (* (/ 8.0 10000000000000.0) (- (exp (/ (- v_vic_out 1.8) 0.0271446)) 1.0))) (* (/ 8.0 10000000000000.0) (- (exp (/ (- v_vic_out) 0.0271446)) 1.0))))) (+ (* (+ (* 0.5 Ctot_xtalk_p) (/ 2.0 1000000000000.0)) (+ (* 0.5 Ctot_xtalk_n) (/ 2.5 1000000000000.0))) (* (* 0.5 Cm_xtalk) (+ (+ (* 0.5 Ctot_xtalk_p) (/ 2.0 1000000000000.0)) (+ (* 0.5 Ctot_xtalk_n) (/ 2.5 1000000000000.0)))))))
  (= d/dt[v_vic_in] (/ (+ (* (+ (* 0.5 Ctot_xtalk_p) (* 0.5 Cm_xtalk)) (- (- (/ v_vic_in 50.0)) i_xtalk_n)) (* (* 0.5 Cm_xtalk) (- (/ (- (/ 1.8 (+ 1.0 (exp (- (/ (- t (/ 1.0 10000000000.0)) (/ 5.0 100000000000.0)))))) v_agg_in) 28.0) i_xtalk_p))) (+ (* (* 0.5 Ctot_xtalk_p) (* 0.5 Ctot_xtalk_n)) (* (* 0.5 Cm_xtalk) (+ (* 0.5 Ctot_xtalk_p) (* 0.5 Ctot_xtalk_n))))))
  (= d/dt[v_vic_out] (/ (+ (* (+ (+ (* 0.5 Ctot_xtalk_p) (/ 2.0 1000000000000.0)) (* 0.5 Cm_xtalk)) (+ (- i_xtalk_n (* (/ 8.0 10000000000000.0) (- (exp (/ (- v_vic_out 1.8) 0.0271446)) 1.0))) (* (/ 8.0 10000000000000.0) (- (exp (/ (- v_vic_out) 0.0271446)) 1.0)))) (* (* 0.5 Cm_xtalk) (- i_xtalk_p (/ v_agg_out 50.0)))) (+ (* (+ (* 0.5 Ctot_xtalk_p) (/ 2.0 1000000000000.0)) (+ (* 0.5 Ctot_xtalk_n) (/ 2.5 1000000000000.0))) (* (* 0.5 Cm_xtalk) (+ (+ (* 0.5 Ctot_xtalk_p) (/ 2.0 1000000000000.0)) (+ (* 0.5 Ctot_xtalk_n) (/ 2.5 1000000000000.0)))))))
  (= d/dt[i_xtalk_p] (/ (- (* (+ Ltot_xtalk_n l_via) (- (- v_agg_in v_agg_out) (* Rdc_xtalk_p i_xtalk_p))) (* M_xtalk_n_xtalk_p (- (- v_vic_in v_vic_out) (* Rdc_xtalk_p i_xtalk_n)))) (- (* (+ Ltot_xtalk_p l_via) (+ Ltot_xtalk_n l_via)) (* M_xtalk_n_xtalk_p M_xtalk_n_xtalk_p))))
  (= d/dt[i_xtalk_n] (/ (- (* (+ Ltot_xtalk_p l_via) (- (- v_vic_in v_vic_out) (* Rdc_xtalk_p i_xtalk_n))) (* M_xtalk_n_xtalk_p (- (- v_agg_in v_agg_out) (* Rdc_xtalk_p i_xtalk_p)))) (- (* (+ Ltot_xtalk_n l_via) (+ Ltot_xtalk_p l_via)) (* M_xtalk_n_xtalk_p M_xtalk_n_xtalk_p))))
))

(assert (= [t_t v_agg_in_t v_agg_out_t v_vic_in_t v_vic_out_t i_xtalk_p_t i_xtalk_n_t] (integral 0.0 tau_hit [t_0 v_agg_in_0 v_agg_out_0 v_vic_in_0 v_vic_out_0 i_xtalk_p_0 i_xtalk_n_0] flow_1)))
(assert (forall_t 1 [0.0 tau_hit] (and (>= v_agg_in_t (- 0.2)) (<= v_agg_in_t 2.2))))
(assert (forall_t 1 [0.0 tau_hit] (and (>= v_agg_out_t (- 0.5)) (<= v_agg_out_t 2.5))))
(assert (forall_t 1 [0.0 tau_hit] (and (>= v_vic_in_t (- 0.5)) (<= v_vic_in_t 1.5))))
(assert (forall_t 1 [0.0 tau_hit] (and (>= v_vic_out_t (- 0.8)) (<= v_vic_out_t 1.8))))
(assert (forall_t 1 [0.0 tau_hit] (and (>= i_xtalk_p_t (- 5.0)) (<= i_xtalk_p_t 5.0))))
