; Edge-coupled microstrip coupling factor kc (xtalk)
(declare-fun kc_xtalk () Real)
(assert (and (>= kc_xtalk (/ 1.0 10000.0)) (<= kc_xtalk 0.95)))
; Differential impedance Z_diff [Ohm] (xtalk)
(declare-fun Zdiff_xtalk () Real)
(assert (and (>= Zdiff_xtalk 20.0) (<= Zdiff_xtalk 300.0)))
