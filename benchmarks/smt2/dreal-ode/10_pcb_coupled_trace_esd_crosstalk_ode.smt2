(declare-fun M_xtalk_n_xtalk_p () Real)
(assert (and (>= M_xtalk_n_xtalk_p 0.0) (<= M_xtalk_n_xtalk_p 0.001)))
; Algebraic sqrt constraint su_xtalk_p^2 = radicand (Hammerstad-Jensen sqrt(1 + 12/u) for xtalk_p)
(assert (= (* su_xtalk_p su_xtalk_p) 7.256517205422))
; Hammerstad-Jensen effective permittivity (xtalk_p)
(assert (= eeff_xtalk_p (+ (/ (+ er_agg 1.0) 2.0) (/ (- er_agg 1.0) (* 2.0 su_xtalk_p)))))
