(assert (= (* su_tl50 su_tl50) (+ 1.0 (/ 12.0 (/ (+ (+ (/ 1.8 10000.0) dw_etch) (* 0.48 t_cu)) (+ (/ 1.0 10000.0) dh_lam))))))
; Hammerstad-Jensen effective permittivity (tl50)
(assert (= eeff_tl50 (+ (/ (+ er_lam 1.0) 2.0) (/ (- er_lam 1.0) (* 2.0 su_tl50)))))
